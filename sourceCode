        // =========================================================
        // UPDATE
        // =========================================================

        public override void OnUpdate()
        {
            if (!Enabled ||
                Mode == VignetteMode.Off)
            {
                HideVignette();

                AudioSafetyCheck();

                return;
            }

            EnsureVignette();

            if (vignetteRenderer == null)
                return;

            UpdateTransform();

            if (dying)
            {
                UpdateDeath();
            }
            else
            {
                UpdateDamage();
            }

            UpdateMaterial();

            // Don't leave renderer running when fully invisible.
            if (!dying &&
                currentAlpha <= 0.001f &&
                pulseAlpha <= 0.001f)
            {
                vignetteRenderer.enabled =
                    false;
            }
            else
            {
                vignetteRenderer.enabled =
                    true;
            }

            AudioSafetyCheck();
        }

        // =========================================================
        // DAMAGE ANIMATION
        // =========================================================

        private static void UpdateDamage()
        {
            // -----------------------------------------------------
            // DAMAGE HOLD
            // -----------------------------------------------------

            if (damageTimer > 0f)
            {
                damageTimer -=
                    Time.unscaledDeltaTime;

                currentDamageRadius =
                    Mathf.Lerp(
                        currentDamageRadius,
                        targetDamageRadius,
                        Mathf.Clamp01(
                            Time.unscaledDeltaTime *
                            DamageCrowdInSpeed
                        )
                    );
            }
            else
            {
                // Return the vignette to the outside edge.
                targetDamageRadius =
                    StartingRadius;

                currentDamageRadius =
                    Mathf.Lerp(
                        currentDamageRadius,
                        StartingRadius,
                        Mathf.Clamp01(
                            Time.unscaledDeltaTime *
                            DamageCrowdOutSpeed
                        )
                    );

                pulseAlpha =
                    Mathf.MoveTowards(
                        pulseAlpha,
                        0f,
                        Time.unscaledDeltaTime *
                        DamageFadeSpeed
                    );

                damageStrength =
                    Mathf.MoveTowards(
                        damageStrength,
                        0f,
                        Time.unscaledDeltaTime *
                        DamageFadeSpeed
                    );
            }

            // -----------------------------------------------------
            // ALPHA
            // -----------------------------------------------------

            targetAlpha =
                pulseAlpha;

            float alphaSpeed =
                damageTimer > 0f
                    ? 14f
                    : 5f;

            currentAlpha =
                Mathf.Lerp(
                    currentAlpha,
                    targetAlpha,
                    Mathf.Clamp01(
                        Time.unscaledDeltaTime *
                        alphaSpeed
                    )
                );

            if (pulseAlpha <= 0.001f)
            {
                currentAlpha =
                    Mathf.MoveTowards(
                        currentAlpha,
                        0f,
                        Time.unscaledDeltaTime *
                        DamageFadeSpeed
                    );
            }

            // -----------------------------------------------------
            // CROWD THE TEXTURE INWARD
            // -----------------------------------------------------

            UpdateRadius(
                currentDamageRadius
            );
        }

        // =========================================================
        // DEATH UPDATE
        // =========================================================

        private static void UpdateDeath()
        {
            heartbeatTimer +=
                Time.unscaledDeltaTime *
                HeartbeatSpeed;

            deathProgress +=
                Time.unscaledDeltaTime *
                DeathCloseSpeed;

            deathProgress =
                Mathf.Clamp01(
                    deathProgress
                );

            float eased =
                SmootherStep(
                    deathProgress
                );

            float radius =
                Mathf.Lerp(
                    StartingRadius,
                    DeathRadius,
                    eased
                );

            float heartbeat = 0f;

            if (HeartbeatEnabled &&
                !dead)
            {
                heartbeat =
                    GetHeartbeatPulse();

                radius -=
                    heartbeat *
                    0.022f;
            }

            radius =
                Mathf.Max(
                    DeathRadius,
                    radius
                );

            UpdateRadius(radius);

            float desiredAlpha =
                Mathf.Lerp(
                    VignetteIntensity,
                    1f,
                    eased
                );

            if (HeartbeatEnabled &&
                !dead)
            {
                desiredAlpha +=
                    heartbeat *
                    HeartbeatStrength;
            }

            desiredAlpha =
                Mathf.Clamp01(
                    desiredAlpha
                );

            currentAlpha =
                Mathf.Lerp(
                    currentAlpha,
                    desiredAlpha,
                    Mathf.Clamp01(
                        Time.unscaledDeltaTime *
                        9f
                    )
                );

            if (dead &&
                deathProgress >= 1f)
            {
                currentAlpha =
                    Mathf.MoveTowards(
                        currentAlpha,
                        1f,
                        Time.unscaledDeltaTime *
                        DeathFadeSpeed
                    );
            }
        }

        // =========================================================
        // HEARTBEAT
        // =========================================================

        private static float GetHeartbeatPulse()
        {
            float cycle =
                heartbeatTimer % 1f;

            float first =
                GaussianPulse(
                    cycle,
                    0.10f,
                    0.055f
                );

            float second =
                GaussianPulse(
                    cycle,
                    0.28f,
                    0.045f
                );

            second *= 0.65f;

            return Mathf.Clamp01(
                first +
                second
            );
        }

        private static float GaussianPulse(
            float x,
            float center,
            float width
        )
        {
            float difference =
                x - center;

            return Mathf.Exp(
                -(difference *
                  difference) /
                (
                    2f *
                    width *
                    width
                )
            );
        }

        // =========================================================
        // CREATE VIGNETTE
        // =========================================================

        private static void EnsureVignette()
        {
            if (vignetteObject == null)
            {
                CreateVignette();
            }
        }

        private static void CreateVignette()
        {
            if (Player.Head == null)
                return;

            DestroyVignette();

            try
            {
                headsetCamera =
                    Player.Head
                        .GetComponentInChildren<Camera>(
                            true
                        );
            }
            catch
            {
                headsetCamera = null;
            }

            vignetteObject =
                GameObject.CreatePrimitive(
                    PrimitiveType.Quad
                );

            vignetteObject.name =
                "QuestDeathVignette_PCStyle";

            Collider collider =
                vignetteObject
                    .GetComponent<Collider>();

            if (collider != null)
            {
                UnityEngine.Object.Destroy(
                    collider
                );
            }

            vignetteObject.transform.SetParent(
                Player.Head,
                false
            );

            vignetteObject.transform.localPosition =
                new Vector3(
                    0f,
                    0f,
                    0.25f
                );

            vignetteObject.transform.localRotation =
                Quaternion.Euler(
                    0f,
                    180f,
                    0f
                );

            vignetteObject.transform.localScale =
                new Vector3(
                    1.15f,
                    1.05f,
                    1f
                );

            if (headsetCamera != null)
            {
                vignetteObject.layer =
                    headsetCamera.gameObject.layer;
            }

            vignetteRenderer =
                vignetteObject
                    .GetComponent<MeshRenderer>();

            Shader shader =
                Shader.Find(
                    "Sprites/Default"
                );

            if (shader == null)
            {
                shader =
                    Shader.Find(
                        "Unlit/Transparent"
                    );
            }

            if (shader == null)
            {
                Error(
                    "No transparent shader found."
                );

                DestroyVignette();

                return;
            }

            vignetteMaterial =
                new Material(
                    shader
                );

            vignetteMaterial.name =
                "QuestDeathVignetteMaterial";

            vignetteMaterial.renderQueue =
                5000;

            vignetteRenderer.material =
                vignetteMaterial;

            vignetteTexture =
                new Texture2D(
                    TextureSize,
                    TextureSize,
                    TextureFormat.RGBA32,
                    false
                );

            vignetteTexture.wrapMode =
                TextureWrapMode.Clamp;

            vignetteTexture.filterMode =
                FilterMode.Bilinear;

            currentRadius = -1f;

            currentDamageRadius =
                StartingRadius;

            targetDamageRadius =
                StartingRadius;

            BuildTexture(
                StartingRadius
            );

            HideVignette();

            Log(
                "Quest vignette renderer created."
            );
        }

        // =========================================================
        // HEAD FOLLOW
        // =========================================================

        private static void UpdateTransform()
        {
            if (Player.Head == null ||
                vignetteObject == null)
            {
                return;
            }

            if (vignetteObject.transform.parent !=
                Player.Head)
            {
                vignetteObject.transform.SetParent(
                    Player.Head,
                    false
                );
            }

            vignetteObject.transform.localPosition =
                new Vector3(
                    0f,
                    0f,
                    0.25f
                );

            vignetteObject.transform.localRotation =
                Quaternion.Euler(
                    0f,
                    180f,
                    0f
                );

            vignetteObject.transform.localScale =
                new Vector3(
                    1.15f,
                    1.05f,
                    1f
                );

            if (headsetCamera == null)
            {
                try
                {
                    headsetCamera =
                        Player.Head
                            .GetComponentInChildren<Camera>(
                                true
                            );
                }
                catch
                {
                    headsetCamera = null;
                }
            }

            if (headsetCamera != null)
            {
                vignetteObject.layer =
                    headsetCamera.gameObject.layer;
            }
        }

        // =========================================================
        // RADIUS
        // =========================================================

        private static void UpdateRadius(
            float radius
        )
        {
            // Smaller threshold so damage movement looks smoother.
            if (Mathf.Abs(
                    radius -
                    currentRadius
                ) < 0.006f)
            {
                return;
            }

            if (Time.unscaledTime -
                lastTextureUpdateTime <
                TextureUpdateInterval)
            {
                return;
            }

            lastTextureUpdateTime =
                Time.unscaledTime;

            BuildTexture(radius);
        }

        // =========================================================
        // TEXTURE
        // =========================================================

        private static void BuildTexture(
            float radius
        )
        {
            if (vignetteTexture == null)
                return;

            currentRadius = radius;

            Color32[] pixels =
                new Color32[
                    TextureSize *
                    TextureSize
                ];

            float center =
                (TextureSize - 1) *
                0.5f;

            for (int y = 0;
                 y < TextureSize;
                 y++)
            {
                for (int x = 0;
                     x < TextureSize;
                     x++)
                {
                    float nx =
                        (x - center) /
                        center;

                    float ny =
                        (y - center) /
                        center;

                    // Oval FOV.
                    nx *= 0.92f;

                    float distance =
                        Mathf.Sqrt(
                            nx * nx +
                            ny * ny
                        );

                    float angle =
                        Mathf.Atan2(
                            ny,
                            nx
                        );

                    float distortedRadius =
                        radius;

                    if (IrregularEdges)
                    {
                        distortedRadius +=
                            EdgeNoise(angle) *
                            EdgeDistortion;
                    }

                    float alpha =
                        Mathf.InverseLerp(
                            distortedRadius,
                            distortedRadius +
                            Softness,
                            distance
                        );

                    alpha =
                        Mathf.Clamp01(
                            alpha
                        );

                    alpha =
                        SmoothStep(
                            alpha
                        );

                    float peripheral =
                        Mathf.Clamp01(
                            (
                                distance -
                                0.58f
                            ) /
                            0.50f
                        );

                    if (!PeripheralDarkening)
                    {
                        peripheral = 0f;
                    }

                    // =================================================
                    // DARK RED COLORING
                    // =================================================

                    float r;
                    float g;
                    float b;

                    if (Mode ==
                        VignetteMode.Soft)
                    {
                        // Reference-style darker red:
                        //
                        // almost black at the far edge,
                        // muted dark burgundy closer inward.
                        float dark =
                            Mathf.Lerp(
                                0.07f,
                                0.015f,
                                peripheral
                            );

                        r =
                            Mathf.Lerp(
                                0.20f,
                                0.09f,
                                peripheral
                            );

                        g =
                            dark *
                            0.50f;

                        b =
                            dark *
                            0.45f;

                        // Slight red glow around inner edge.
                        float innerBand =
                            Mathf.Clamp01(
                                1f -
                                Mathf.Abs(
                                    distance -
                                    distortedRadius
                                ) /
                                0.18f
                            );

                        r +=
                            innerBand *
                            0.055f;
                    }
                    else
                    {
                        float darkness =
                            Mathf.Lerp(
                                0.17f,
                                Darkness,
                                alpha
                            );

                        darkness =
                            Mathf.Clamp01(
                                darkness
                            );

                        r =
                            Mathf.Lerp(
                                darkness,
                                1f,
                                RedAmount *
                                0.72f
                            );

                        g =
                            darkness *
                            (
                                1f -
                                RedAmount *
                                0.92f
                            );

                        b =
                            darkness *
                            (
                                1f -
                                RedAmount
                            );
                    }

                    // Darken the extreme edge.
                    if (PeripheralDarkening)
                    {
                        float extremeDark =
                            Mathf.Lerp(
                                1f,
                                0.32f,
                                peripheral
                            );

                        r *= extremeDark;
                        g *= extremeDark;
                        b *= extremeDark;
                    }

                    pixels[
                        y *
                        TextureSize +
                        x
                    ] =
                        new Color32(
                            FloatToByte(r),
                            FloatToByte(g),
                            FloatToByte(b),
                            FloatToByte(alpha)
                        );
                }
            }

            vignetteTexture.SetPixels32(
                pixels
            );

            vignetteTexture.Apply(
                false,
                false
            );

            if (vignetteMaterial != null)
            {
                vignetteMaterial.mainTexture =
                    vignetteTexture;
            }
        }

        // =========================================================
        // ORGANIC EDGE
        // =========================================================

        private static float EdgeNoise(
            float angle
        )
        {
            float n1 =
                Mathf.Sin(
                    angle *
                    EdgeNoiseScale
                );

            float n2 =
                Mathf.Sin(
                    angle *
                    3.1f +
                    1.7f
                ) *
                0.55f;

            float n3 =
                Mathf.Sin(
                    angle *
                    9.3f +
                    0.6f
                ) *
                0.28f;

            float n4 =
                Mathf.Sin(
                    angle *
                    14.7f +
                    2.2f
                ) *
                0.12f;

            return (
                n1 +
                n2 +
                n3 +
                n4
            ) /
            1.95f;
        }

        // =========================================================
        // MATERIAL
        // =========================================================

        private static void UpdateMaterial()
        {
            if (vignetteMaterial == null)
                return;

            float alpha =
                Mathf.Clamp01(
                    currentAlpha *
                    VignetteIntensity
                );

            vignetteMaterial.color =
                new Color(
                    1f,
                    1f,
                    1f,
                    alpha
                );
        }

        private static void HideVignette()
        {
            if (vignetteMaterial != null)
            {
                vignetteMaterial.color =
                    new Color(
                        1f,
                        1f,
                        1f,
                        0f
                    );
            }

            if (vignetteRenderer != null)
            {
                vignetteRenderer.enabled =
                    false;
            }
        }

        // =========================================================
        // AUDIO
        // =========================================================

        private static void RestoreNormalAudio()
        {
            try
            {
                BoneLib.Audio.SetMuffle(
                    1f
                );
            }
            catch (Exception ex)
            {
                Warn(
                    "Could not reset audio: " +
                    ex.Message
                );
            }

            StopDeathAudioSources();
        }

        private static void StopDeathAudioSources()
        {
            try
            {
                if (Player.Head == null)
                    return;

                var sources =
                    Player.Head
                        .GetComponentsInChildren<AudioSource>(
                            true
                        );

                foreach (var source in sources)
                {
                    if (source == null)
                        continue;

                    if (!source.isPlaying)
                        continue;

                    string objectName = "";
                    string clipName = "";

                    try
                    {
                        objectName =
                            source.gameObject.name
                                .ToLowerInvariant();
                    }
                    catch
                    {
                    }

                    try
                    {
                        if (source.clip != null)
                        {
                            clipName =
                                source.clip.name
                                    .ToLowerInvariant();
                        }
                    }
                    catch
                    {
                    }

                    bool deathRelated =
                        objectName.Contains("heart") ||
                        objectName.Contains("heartbeat") ||
                        objectName.Contains("death") ||
                        objectName.Contains("dying") ||
                        objectName.Contains("critical") ||
                        objectName.Contains("neardeath") ||
                        objectName.Contains("near_death") ||

                        clipName.Contains("heart") ||
                        clipName.Contains("heartbeat") ||
                        clipName.Contains("death") ||
                        clipName.Contains("dying") ||
                        clipName.Contains("critical") ||
                        clipName.Contains("neardeath") ||
                        clipName.Contains("near_death");

                    if (!deathRelated)
                        continue;

                    source.Stop();
                }
            }
            catch (Exception ex)
            {
                Warn(
                    "Death audio cleanup failed: " +
                    ex.Message
                );
            }
        }

        private static void AudioSafetyCheck()
        {
            if (dying || dead)
                return;

            if (Time.unscaledTime -
                lastAudioSafetyReset <
                AudioResetInterval)
            {
                return;
            }

            lastAudioSafetyReset =
                Time.unscaledTime;

            try
            {
                BoneLib.Audio.SetMuffle(
                    1f
                );
            }
            catch
            {
            }
        }

