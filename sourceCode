        public override void OnInitializeMelon()
        {
            Instance = this;

            Log("========================================");
            Log(" Quest Death Vignette Replacer v1.4");
            Log(" Damage crowding + darker Soft preset");
            Log("========================================");

            SetupMenu();

            Hooking.OnPlayerDamageReceived +=
                OnPlayerDamage;

            Hooking.OnPlayerDeathImminent +=
                OnDeathImminent;

            Hooking.OnPlayerDeath +=
                OnDeath;

            Hooking.OnPlayerResurrected +=
                OnResurrected;

            Hooking.OnLevelLoaded += level =>
            {
                RestoreNormalAudio();

                DestroyVignette();

                ResetRuntimeState();

                CreateVignette();

                Log(
                    "Level loaded - vignette recreated."
                );
            };

            Hooking.OnLevelUnloaded += () =>
            {
                RestoreNormalAudio();

                DestroyVignette();

                ResetRuntimeState();

                Log(
                    "Level unloaded - effect cleaned."
                );
            };

            try
            {
                HarmonyInstance.PatchAll();

                Log(
                    "Quest spike suppression loaded."
                );
            }
            catch (Exception ex)
            {
                Warn(
                    "Harmony patch failed: " +
                    ex.Message
                );
            }
        }

