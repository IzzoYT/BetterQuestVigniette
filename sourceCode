    [HarmonyPatch(
        typeof(Player_Health),
        "MakeVignette"
    )]
    public static class VanillaVignettePatch
    {
        public static bool Prefix()
        {
            if (!QuestDeathVignetteMod.Enabled)
                return true;

            if (!QuestDeathVignetteMod.ReplaceVanilla)
                return true;

            if (QuestDeathVignetteMod.Mode ==
                VignetteMode.Off)
            {
                return true;
            }

            // Remove the original Quest spike effect.
            return false;
        }
    }
