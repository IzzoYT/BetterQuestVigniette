        // =========================================================
        // PLAYER DAMAGE
        // =========================================================

        private static void OnPlayerDamage(
            RigManager rigManager,
            float damage
        )
        {
            if (!Enabled)
                return;

            if (!DamageVignette)
                return;

            if (Mode ==
                VignetteMode.Off)
                return;

            EnsureVignette();

            // Convert BONELAB damage into a useful 0-1 strength.
            //
            // Even tiny hits will now produce a visible vignette.
            float normalizedDamage =
                Mathf.Clamp01(
                    damage / 20f
                );

            normalizedDamage =
                Mathf.Max(
                    normalizedDamage,
                    0.18f
                );

            TriggerDamageEffect(
                normalizedDamage
            );

            Log(
                "Damage received: " +
                damage.ToString("0.00") +
                " | vignette strength: " +
                normalizedDamage.ToString("0.00")
            );
        }

        // =========================================================
        // TRIGGER DAMAGE EFFECT
        // =========================================================

        private static void TriggerDamageEffect(
            float strength
        )
        {
            strength =
                Mathf.Clamp01(
                    strength
                );

            damageStrength =
                Mathf.Max(
                    damageStrength,
                    strength
                );

            damageTimer =
                DamageHoldTime;

            // Make sure the hit is actually visible.
            float hitAlpha =
                Mathf.Lerp(
                    MinimumDamageEffect,
                    DamagePulseIntensity,
                    strength
                );

            pulseAlpha =
                Mathf.Max(
                    pulseAlpha,
                    hitAlpha
                );

            targetAlpha =
                Mathf.Max(
                    targetAlpha,
                    hitAlpha
                );

            // Crowd inward.
            targetDamageRadius =
                StartingRadius -
                (
                    DamageCrowdStrength *
                    Mathf.Lerp(
                        0.45f,
                        1f,
                        strength
                    )
                );

            targetDamageRadius =
                Mathf.Clamp(
                    targetDamageRadius,
                    0.18f,
                    StartingRadius
                );

            // Immediately make the renderer visible.
            if (vignetteRenderer != null)
            {
                vignetteRenderer.enabled =
                    true;
            }
        }

        // =========================================================
        // DEATH IMMINENT
        // =========================================================

        private static void OnDeathImminent(
            RigManager rigManager
        )
        {
            if (!Enabled)
                return;

            if (!DeathVignette)
                return;

            if (Mode ==
                VignetteMode.Off)
                return;

            EnsureVignette();

            dying = true;
            dead = false;

            deathProgress = 0f;
            heartbeatTimer = 0f;

            targetAlpha =
                Mathf.Max(
                    currentAlpha,
                    VignetteIntensity
                );

            Log(
                "Death imminent - death vignette started."
            );
        }

        // =========================================================
        // DEATH
        // =========================================================

        private static void OnDeath(
            RigManager rigManager
        )
        {
            if (!Enabled)
                return;

            if (!DeathVignette)
                return;

            EnsureVignette();

            dying = true;
            dead = true;

            targetAlpha = 1f;

            Log(
                "Player death detected."
            );
        }

