        private static void TestDamage(
            float strength
        )
        {
            if (!Enabled)
                return;

            EnsureVignette();

            dying = false;
            dead = false;

            TriggerDamageEffect(
                strength
            );

            Log(
                "Damage vignette test."
            );
        }

        // =========================================================
        // TEST DEATH
        // =========================================================

        private static void TestDeath()
        {
            if (!Enabled)
                return;

            EnsureVignette();

            dying = true;
            dead = false;

            deathProgress = 0f;
            heartbeatTimer = 0f;

            currentAlpha =
                Mathf.Max(
                    currentAlpha,
                    0.30f
                );

            if (vignetteRenderer != null)
            {
                vignetteRenderer.enabled =
                    true;
            }

            Log(
                "Death vignette test."
            );
        }

        // =========================================================
        // RECREATE
        // =========================================================

        private static void RecreateVignette()
        {
            DestroyVignette();

            CreateVignette();

            Log(
                "Vignette recreated."
            );
        }

        // =========================================================
        // RESET
        // =========================================================

        private static void ResetRuntimeState()
        {
            dying = false;
            dead = false;

            deathProgress = 0f;
            heartbeatTimer = 0f;

            damageTimer = 0f;
            damageStrength = 0f;

            currentAlpha = 0f;
            targetAlpha = 0f;
            pulseAlpha = 0f;

            currentDamageRadius =
                StartingRadius;

            targetDamageRadius =
                StartingRadius;
        }

        private static void ResetEffect()
        {
            ResetRuntimeState();

            RestoreNormalAudio();

            ForceTextureRefresh();

            HideVignette();

            Log(
                "Vignette reset."
            );
        }

        // =========================================================
        // FORCE TEXTURE
        // =========================================================

        private static void ForceTextureRefresh()
        {
            currentRadius = -1f;

            currentDamageRadius =
                StartingRadius;

            targetDamageRadius =
                StartingRadius;

            if (vignetteTexture != null)
            {
                BuildTexture(
                    StartingRadius
                );
            }
        }

        // =========================================================
        // DESTROY
        // =========================================================

        private static void DestroyVignette()
        {
            if (vignetteObject != null)
            {
                UnityEngine.Object.Destroy(
                    vignetteObject
                );

                vignetteObject = null;
            }

            if (vignetteMaterial != null)
            {
                UnityEngine.Object.Destroy(
                    vignetteMaterial
                );

                vignetteMaterial = null;
            }

            if (vignetteTexture != null)
            {
                UnityEngine.Object.Destroy(
                    vignetteTexture
                );

                vignetteTexture = null;
            }

            vignetteRenderer = null;
            headsetCamera = null;

            currentRadius = -1f;
        }

        // =========================================================
        // HELPERS
        // =========================================================

        private static byte FloatToByte(
            float value
        )
        {
            return (byte)Mathf.Clamp(
                Mathf.RoundToInt(
                    value *
                    255f
                ),
                0,
                255
            );
        }

        private static float SmoothStep(
            float value
        )
        {
            value =
                Mathf.Clamp01(
                    value
                );

            return value *
                   value *
                   (
                       3f -
                       2f *
                       value
                   );
        }

        private static float SmootherStep(
            float value
        )
        {
            value =
                Mathf.Clamp01(
                    value
                );

            return value *
                   value *
                   value *
                   (
                       value *
                       (
                           value *
                           6f -
                           15f
                       ) +
                       10f
                   );
        }
    }

